<style>
  .ncdr-shop-brands {
    padding: 64px 60px;
    background: #fff;
    border-bottom: 1px solid var(--ncdr-light-gray);
  }

  .ncdr-shop-brands__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .ncdr-shop-brands__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .ncdr-shop-brands__eyebrow::before,
  .ncdr-shop-brands__eyebrow::after {
    content: '';
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--ncdr-gold);
    opacity: 0.4;
  }

  .ncdr-shop-brands__heading {
    font-family: var(--ncdr-font-heading);
    font-size: 28px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ncdr-green-deep);
    line-height: 1.15;
  }

  .ncdr-shop-brands__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* Brand tile */
  .ncdr-brand-tile {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
    background: var(--ncdr-green-deep);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ncdr-brand-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 36px rgba(0,0,0,0.2);
  }

  .ncdr-brand-tile__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ncdr-brand-tile__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ncdr-brand-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(14, 25, 10, 0.90) 0%,
      rgba(14, 25, 10, 0.55) 50%,
      rgba(14, 25, 10, 0.30) 100%
    );
    z-index: 1;
  }

  .ncdr-brand-tile__content {
    position: relative;
    z-index: 2;
    padding: 28px 28px 24px;
  }

  .ncdr-brand-tile__name {
    font-family: var(--ncdr-font-heading);
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ncdr-gold);
    margin-bottom: 6px;
    line-height: 1;
  }

  .ncdr-brand-tile__credential {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.65);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .ncdr-brand-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ncdr-font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.35);
    padding-bottom: 2px;
  }

  @media (max-width: 989px) {
    .ncdr-shop-brands { padding: 48px 24px; }
    .ncdr-shop-brands__grid { grid-template-columns: repeat(2, 1fr); }
    .ncdr-brand-tile:last-child { grid-column: 1 / -1; max-width: 360px; justify-self: center; width: 100%; }
  }
  @media (max-width: 749px) {
    .ncdr-shop-brands__grid { grid-template-columns: 1fr; }
    .ncdr-brand-tile:last-child { grid-column: auto; max-width: none; justify-self: auto; }
    .ncdr-brand-tile { min-height: 180px; }
  }
</style>

<div class="ncdr-shop-brands">
  <div class="ncdr-shop-brands__header">
    <div class="ncdr-shop-brands__eyebrow">Authorized Dealers</div>
    <h2 class="ncdr-shop-brands__heading">{{ section.settings.heading | default: 'Shop by Brand' }}</h2>
  </div>

  <div class="ncdr-shop-brands__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="ncdr-brand-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="ncdr-brand-tile__bg">
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.brand_name }}"
              loading="lazy"
              width="800"
              height="440"
            >
          </div>
        {%- endif -%}
        <div class="ncdr-brand-tile__overlay"></div>
        <div class="ncdr-brand-tile__content">
          <div class="ncdr-brand-tile__name">{{ block.settings.brand_name }}</div>
          <div class="ncdr-brand-tile__credential">{{ block.settings.credential }}</div>
          <div class="ncdr-brand-tile__cta">Shop {{ block.settings.brand_name }} →</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "NCDR Shop Brands",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Brand" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Honma" },
        { "type": "text", "id": "credential", "label": "Credential", "default": "Verified Retailer" },
        { "type": "url", "id": "link", "label": "Collection link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NCDR Shop Brands",
      "blocks": [
        { "type": "brand", "settings": { "brand_name": "Majesty", "credential": "Authorized Dealer" } },
        { "type": "brand", "settings": { "brand_name": "Honma", "credential": "Verified Retailer" } },
        { "type": "brand", "settings": { "brand_name": "XXIO", "credential": "Authorized Dealer" } }
      ]
    }
  ]
}
{% endschema %}
