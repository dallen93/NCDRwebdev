<style>
  .ncdr-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
  }

  /* ── Left: info panel ── */
  .ncdr-contact__info {
    background: var(--ncdr-green-deep);
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ncdr-contact__info-eyebrow {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .ncdr-contact__info-eyebrow span {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--ncdr-gold);
    opacity: 0.4;
  }

  .ncdr-contact__info-heading {
    font-family: var(--ncdr-font-heading);
    font-size: 32px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.01em;
    margin-bottom: 10px;
    line-height: 1.1;
  }

  .ncdr-contact__info-subtext {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    font-weight: 300;
    line-height: 1.7;
    max-width: 360px;
  }

  .ncdr-contact__block {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 22px;
  }

  .ncdr-contact__block-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    margin-bottom: 10px;
  }

  .ncdr-contact__block-text {
    font-size: 14px;
    color: rgba(255,255,255,0.7);
    font-weight: 300;
    line-height: 1.8;
  }
  .ncdr-contact__block-text a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
  }
  .ncdr-contact__block-text a:hover { color: var(--ncdr-gold); }

  /* Map embed */
  .ncdr-contact__map {
    width: 100%;
    height: 160px;
    border-radius: 6px;
    overflow: hidden;
    margin-top: 14px;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .ncdr-contact__map iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Hours groups */
  .ncdr-contact__hours-group {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 22px;
  }
  .ncdr-contact__hours-group + .ncdr-contact__hours-group {
    margin-top: 0;
  }

  .ncdr-contact__hours-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: rgba(255,255,255,0.65);
    font-weight: 300;
    padding: 3px 0;
  }
  .ncdr-contact__hours-row span:last-child { color: rgba(255,255,255,0.45); }

  .ncdr-contact__hours-note {
    margin-top: 8px;
    font-size: 12px;
    color: rgba(255,255,255,0.35);
    font-style: italic;
  }

  /* Contact with icons */
  .ncdr-contact__contact-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: rgba(255,255,255,0.7);
    font-weight: 300;
    padding: 4px 0;
  }
  .ncdr-contact__contact-row a {
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: color 0.2s;
  }
  .ncdr-contact__contact-row a:hover { color: var(--ncdr-gold); }
  .ncdr-contact__contact-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--ncdr-gold);
    opacity: 0.8;
  }

  /* ── Right: form ── */
  .ncdr-contact__form {
    background: #fff;
    padding: 64px 56px;
  }

  .ncdr-contact__form-eyebrow {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ncdr-contact__form-eyebrow span {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--ncdr-gold);
    opacity: 0.4;
  }

  .ncdr-contact__form-heading {
    font-family: var(--ncdr-font-heading);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 28px;
  }

  .ncdr-contact__field {
    margin-bottom: 14px;
  }

  .ncdr-contact__label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ncdr-text-mid);
    margin-bottom: 5px;
  }

  .ncdr-contact__input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--ncdr-light-gray);
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 13px;
    font-family: var(--ncdr-font-body);
    color: var(--ncdr-text-dark);
    background: #fff;
    transition: border-color 0.2s;
  }
  .ncdr-contact__input:focus {
    outline: none;
    border-color: var(--ncdr-gold);
  }
  textarea.ncdr-contact__input { resize: vertical; }

  .ncdr-contact__submit {
    width: 100%;
    background: var(--ncdr-green-deep);
    color: #fff;
    font-family: var(--ncdr-font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 13px 20px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 8px;
  }
  .ncdr-contact__submit:hover { background: var(--ncdr-green); }

  @media (max-width: 989px) {
    .ncdr-contact { grid-template-columns: 1fr; }
    .ncdr-contact__info,
    .ncdr-contact__form { padding: 48px 24px; }
  }
</style>

<div class="ncdr-contact">
  <!-- Info Panel -->
  <div class="ncdr-contact__info">

    <!-- Heading -->
    <div>
      <h2 class="ncdr-contact__info-heading">{{ section.settings.info_heading }}</h2>
      {%- if section.settings.info_subtext != blank -%}
        <p class="ncdr-contact__info-subtext">{{ section.settings.info_subtext }}</p>
      {%- endif -%}
    </div>

    <!-- Location + Map -->
    <div class="ncdr-contact__block">
      <div class="ncdr-contact__block-label">Location</div>
      <div class="ncdr-contact__block-text">
        {{ section.settings.address | newline_to_br }}
      </div>
      {%- if section.settings.map_embed_url != blank -%}
        <div class="ncdr-contact__map">
          <iframe
            src="{{ section.settings.map_embed_url }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Northcrest Golf Driving Range map">
          </iframe>
        </div>
      {%- endif -%}
    </div>

    <!-- Hours groups (hours_group blocks followed by hours_row blocks) -->
    {%- assign in_group = false -%}
    {%- assign current_note = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'hours_group' -%}
        {%- if in_group -%}
          {%- if current_note != blank -%}
            <div class="ncdr-contact__hours-note">{{ current_note }}</div>
          {%- endif -%}
          </div></div>
        {%- endif -%}
        <div class="ncdr-contact__hours-group">
          <div class="ncdr-contact__block-label">{{ block.settings.label }}</div>
          <div class="ncdr-contact__block-text">
        {%- assign in_group = true -%}
        {%- assign current_note = block.settings.note -%}
      {%- elsif block.type == 'hours_row' -%}
        {%- if in_group == false -%}
          {%- comment -%} Legacy fallback: bare hours_row without a group header {%- endcomment -%}
          <div class="ncdr-contact__hours-group">
            <div class="ncdr-contact__block-label">Hours</div>
            <div class="ncdr-contact__block-text">
          {%- assign in_group = true -%}
          {%- assign current_note = '' -%}
        {%- endif -%}
        <div class="ncdr-contact__hours-row">
          <span>{{ block.settings.days }}</span>
          <span>{{ block.settings.hours }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if in_group -%}
      {%- if current_note != blank -%}
        <div class="ncdr-contact__hours-note">{{ current_note }}</div>
      {%- endif -%}
      </div></div>
    {%- endif -%}

    <!-- Contact -->
    <div class="ncdr-contact__block">
      <div class="ncdr-contact__block-label">Contact</div>
      <div class="ncdr-contact__contact-row">
        <svg class="ncdr-contact__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.07 1.18 2 2 0 012.06 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
      </div>
      <div class="ncdr-contact__contact-row">
        <svg class="ncdr-contact__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="M2 7l10 7 10-7"/>
        </svg>
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      </div>
    </div>

  </div>

  <!-- Form -->
  <div class="ncdr-contact__form">
    <div class="ncdr-contact__form-eyebrow">Get In Touch <span></span></div>
    <h2 class="ncdr-contact__form-heading">{{ section.settings.form_heading }}</h2>

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p style="color:var(--ncdr-green);font-weight:600;margin-bottom:20px;">Message sent! We'll get back to you soon.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p style="color:#c0392b;margin-bottom:12px;">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-name">Name</label>
        <input class="ncdr-contact__input" type="text" id="contact-name" name="contact[name]" required placeholder="Your full name">
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-email">Email</label>
        <input class="ncdr-contact__input" type="email" id="contact-email" name="contact[email]" required placeholder="your@email.com">
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-phone">Phone</label>
        <input class="ncdr-contact__input" type="tel" id="contact-phone" name="contact[phone]" placeholder="(xxx) xxx-xxxx">
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-subject">Subject</label>
        <select class="ncdr-contact__input" id="contact-subject" name="contact[subject]">
          <option value="">Select a topic</option>
          <option>General Inquiry</option>
          <option>Lessons</option>
          <option>Club Repair</option>
          <option>Trade-In</option>
          <option>Events & Private Bookings</option>
          <option>Simulator Reservations</option>
          <option>Pro Shop / Orders</option>
        </select>
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-message">Message</label>
        <textarea class="ncdr-contact__input" id="contact-message" name="contact[body]" rows="5" placeholder="How can we help?"></textarea>
      </div>
      <button type="submit" class="ncdr-contact__submit">Send Message</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "NCDR Contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "info_heading", "label": "Info panel heading", "default": "Come see us" },
    { "type": "textarea", "id": "info_subtext", "label": "Info panel subtext" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "3545 Northcrest Road\nAtlanta, GA 30340\nOff I-85 N at the Northcrest Road exit." },
    { "type": "text", "id": "map_embed_url", "label": "Google Maps embed URL" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(770) 723-0002" },
    { "type": "text", "id": "email", "label": "Email", "default": "management@northcrestgolf.com" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send Us a Message" }
  ],
  "blocks": [
    {
      "type": "hours_group",
      "name": "Hours Group",
      "settings": [
        { "type": "text", "id": "label", "label": "Group label (e.g. Pro Shop Hours)" },
        { "type": "text", "id": "note", "label": "Note (optional, shown below rows)" }
      ]
    },
    {
      "type": "hours_row",
      "name": "Hours Row",
      "settings": [
        { "type": "text", "id": "days", "label": "Days" },
        { "type": "text", "id": "hours", "label": "Hours" }
      ]
    }
  ],
  "presets": [{ "name": "NCDR Contact" }]
}
{% endschema %}
