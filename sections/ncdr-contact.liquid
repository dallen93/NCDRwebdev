<style>
  .ncdr-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
  }

  /* ── Left: info panel ── */
  .ncdr-contact__info {
    background: var(--ncdr-off-white);
    padding: 64px 48px 0;
    display: flex;
    flex-direction: column;
  }

  /* 2×2 quadrant grid */
  .ncdr-contact__quadrants {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .ncdr-contact__quad {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ncdr-contact__quad-icon {
    width: 32px;
    height: 32px;
    color: var(--ncdr-gold);
    margin-bottom: 12px;
    flex-shrink: 0;
  }

  .ncdr-contact__quad-title {
    font-family: var(--ncdr-font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--ncdr-green-deep);
    letter-spacing: 0.02em;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .ncdr-contact__quad-body {
    font-size: 13px;
    color: var(--ncdr-text-mid);
    font-weight: 300;
    line-height: 1.8;
  }
  .ncdr-contact__quad-body a {
    color: var(--ncdr-text-mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  .ncdr-contact__quad-body a:hover { color: var(--ncdr-gold); }

  .ncdr-contact__quad-subtitle {
    font-size: 11px;
    font-style: italic;
    color: rgba(0,0,0,0.35);
    margin-bottom: 6px;
    line-height: 1.4;
  }

  /* Map */
  .ncdr-contact__map {
    flex: 1;
    min-height: 220px;
    margin-bottom: 48px;
  }
  .ncdr-contact__map iframe {
    width: 100%;
    height: 100%;
    min-height: 220px;
    border: none;
    display: block;
  }

  /* ── Right: form ── */
  .ncdr-contact__form {
    background: #fff;
    padding: 64px 56px;
  }

  .ncdr-contact__form-eyebrow {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ncdr-contact__form-eyebrow span {
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--ncdr-gold);
    opacity: 0.4;
  }

  .ncdr-contact__form-heading {
    font-family: var(--ncdr-font-heading);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 28px;
  }

  .ncdr-contact__field {
    margin-bottom: 14px;
  }

  .ncdr-contact__label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ncdr-text-mid);
    margin-bottom: 5px;
  }

  .ncdr-contact__input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--ncdr-light-gray);
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 13px;
    font-family: var(--ncdr-font-body);
    color: var(--ncdr-text-dark);
    background: #fff;
    transition: border-color 0.2s;
  }
  .ncdr-contact__input:focus {
    outline: none;
    border-color: var(--ncdr-gold);
  }
  textarea.ncdr-contact__input { resize: vertical; }

  .ncdr-contact__submit {
    width: 100%;
    background: var(--ncdr-green-deep);
    color: #fff;
    font-family: var(--ncdr-font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 13px 20px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 8px;
  }
  .ncdr-contact__submit:hover { background: var(--ncdr-green); }

  @media (max-width: 989px) {
    .ncdr-contact { grid-template-columns: 1fr; }
    .ncdr-contact__info { padding: 40px 24px 0; }
    .ncdr-contact__form { padding: 48px 24px; }
    .ncdr-contact__map { min-height: 200px; margin-bottom: 32px; }
    .ncdr-contact__map iframe { min-height: 200px; }
    .ncdr-contact__quadrants { grid-template-columns: 1fr; }
    .ncdr-contact__quad { padding: 24px 20px; align-items: flex-start; text-align: left; }
  }
</style>

<div class="ncdr-contact">
  <!-- Info Panel -->
  <div class="ncdr-contact__info">

    <!-- 2×2 Quadrant grid -->
    <div class="ncdr-contact__quadrants">

      <!-- Visit the Pro Shop -->
      <div class="ncdr-contact__quad">
        <svg class="ncdr-contact__quad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <div class="ncdr-contact__quad-title">Visit the Pro Shop</div>
        <div class="ncdr-contact__quad-body">
          3545 Northcrest Road<br>Atlanta, GA 30340
        </div>
      </div>

      <!-- Call the Clubhouse -->
      <div class="ncdr-contact__quad">
        <svg class="ncdr-contact__quad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.07 1.18 2 2 0 012.06 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <div class="ncdr-contact__quad-title">Call the Clubhouse</div>
        <div class="ncdr-contact__quad-body">
          <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
        </div>
      </div>

      <!-- Pro Shop Hours -->
      <div class="ncdr-contact__quad">
        <div class="ncdr-contact__quad-title">Pro Shop Hours</div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'hours_group' and block.settings.label contains 'Pro Shop' -%}
            {%- assign ps_found = true -%}
          {%- endif -%}
          {%- if ps_found and block.type == 'hours_row' -%}
            <div class="ncdr-contact__quad-body">{{ block.settings.days }}: {{ block.settings.hours }}</div>
          {%- endif -%}
          {%- if ps_found and block.type == 'hours_group' and block.settings.label contains 'Range' -%}
            {%- assign ps_found = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Range Hours -->
      <div class="ncdr-contact__quad">
        {%- for block in section.blocks -%}
          {%- if block.type == 'hours_group' and block.settings.label contains 'Range' -%}
            {%- assign rh_label = block.settings.label -%}
            {%- assign rh_note = block.settings.note -%}
            {%- assign rh_found = true -%}
          {%- endif -%}
          {%- if rh_found and block.type == 'hours_row' -%}
            {%- unless rh_title_shown -%}
              <div class="ncdr-contact__quad-title">{{ rh_label }}</div>
              {%- assign rh_title_shown = true -%}
            {%- endunless -%}
            <div class="ncdr-contact__quad-body">{{ block.settings.days }}: {{ block.settings.hours }}</div>
          {%- endif -%}
        {%- endfor -%}
        {%- if rh_note != blank -%}
          <div class="ncdr-contact__quad-subtitle" style="margin-top:8px;">{{ rh_note }}</div>
        {%- endif -%}
      </div>

    </div>

    <!-- Full-width map -->
    {%- if section.settings.map_embed_url != blank -%}
      <div class="ncdr-contact__map">
        <iframe
          src="{{ section.settings.map_embed_url }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Northcrest Golf Driving Range map">
        </iframe>
      </div>
    {%- endif -%}

  </div>

  <!-- Form -->
  <div class="ncdr-contact__form">
    <div class="ncdr-contact__form-eyebrow">Get In Touch <span></span></div>
    <h2 class="ncdr-contact__form-heading">{{ section.settings.form_heading }}</h2>

    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <p style="color:var(--ncdr-green);font-weight:600;margin-bottom:20px;">Message sent! We'll get back to you soon.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p style="color:#c0392b;margin-bottom:12px;">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-name">Name</label>
        <input class="ncdr-contact__input" type="text" id="contact-name" name="contact[name]" required placeholder="Your full name">
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-email">Email</label>
        <input class="ncdr-contact__input" type="email" id="contact-email" name="contact[email]" required placeholder="your@email.com">
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-phone">Phone</label>
        <input class="ncdr-contact__input" type="tel" id="contact-phone" name="contact[phone]" placeholder="(xxx) xxx-xxxx">
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-subject">Subject</label>
        <select class="ncdr-contact__input" id="contact-subject" name="contact[subject]">
          <option value="">Select a topic</option>
          <option>General Inquiry</option>
          <option>Lessons</option>
          <option>Club Repair</option>
          <option>Trade-In</option>
          <option>Events & Private Bookings</option>
          <option>Simulator Reservations</option>
          <option>Pro Shop / Orders</option>
        </select>
      </div>
      <div class="ncdr-contact__field">
        <label class="ncdr-contact__label" for="contact-message">Message</label>
        <textarea class="ncdr-contact__input" id="contact-message" name="contact[body]" rows="5" placeholder="How can we help?"></textarea>
      </div>
      <button type="submit" class="ncdr-contact__submit">Send Message</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "NCDR Contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "map_embed_url", "label": "Google Maps embed URL" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(770) 723-0002" },
    { "type": "text", "id": "email", "label": "Email", "default": "management@northcrestgolf.com" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send Us a Message" }
  ],
  "blocks": [
    {
      "type": "hours_group",
      "name": "Hours Group",
      "settings": [
        { "type": "text", "id": "label", "label": "Group label (e.g. Pro Shop Hours)" },
        { "type": "text", "id": "note", "label": "Note (optional, shown below rows)" }
      ]
    },
    {
      "type": "hours_row",
      "name": "Hours Row",
      "settings": [
        { "type": "text", "id": "days", "label": "Days" },
        { "type": "text", "id": "hours", "label": "Hours" }
      ]
    }
  ],
  "presets": [{ "name": "NCDR Contact" }]
}
{% endschema %}
