{%- comment -%}
  Membership page — 5. FAQ
  One block per question. Tick "Placeholder answer" to show a yellow PLACEHOLDER
  tag on the page until the answer is confirmed; untick it when the answer is final.
  Tokens you can type in answers: [PLAN NAME], [NOTICE PERIOD], [BILLING PARTNER].
{%- endcomment -%}
{% render 'ncdr-mem-assets' %}

{%- liquid
  assign plan_name = settings.mem_plan_name | escape
  assign notice = settings.mem_notice_period | escape
  assign partner = settings.mem_billing_partner | default: '[BILLING PARTNER]' | escape
-%}

<section class="mem mem-section mem-faq" id="mem-faq" aria-labelledby="mem-faq-heading-{{ section.id }}">
  <div class="mem-wrap mem-wrap--narrow">
    <header class="mem-center mem-faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mem-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="mem-h2" id="mem-faq-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </header>

    <div class="mem-faq__list">
      {%- for block in section.blocks -%}
        <details class="mem-faq__item" {{ block.shopify_attributes }}>
          <summary class="mem-faq__q">
            <span>{{ block.settings.question | escape | replace: '[PLAN NAME]', plan_name }}</span>
            <span class="mem-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="mem-faq__a">
            {%- if block.settings.placeholder -%}
              <p><span class="mem-placeholder">Placeholder answer — confirm before launch</span></p>
            {%- endif -%}
            {{ block.settings.answer | replace: '[NOTICE PERIOD]', notice | replace: '[PLAN NAME]', plan_name | replace: '[BILLING PARTNER]', partner }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .mem-faq__header { margin-bottom: 40px; }
  .mem-faq__list { border-top: 2px solid var(--mem-line); }
  .mem-faq__item { border-bottom: 2px solid var(--mem-line); }
  .mem-faq__q {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    min-height: 64px; padding: 18px 4px; cursor: pointer; list-style: none;
    font-family: var(--mem-font-head); font-size: 22px; font-weight: 600; letter-spacing: .02em;
    color: var(--mem-text); line-height: 1.3;
  }
  .mem-faq__q::-webkit-details-marker { display: none; }
  .mem-faq__q:hover, .mem-faq__item[open] > .mem-faq__q { color: var(--mem-green); }
  .mem-faq__icon { position: relative; flex: 0 0 22px; height: 22px; }
  .mem-faq__icon::before, .mem-faq__icon::after {
    content: ''; position: absolute; background: var(--mem-green); border-radius: 2px; transition: transform .2s;
  }
  .mem-faq__icon::before { left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px; }
  .mem-faq__icon::after { top: 0; bottom: 0; left: 50%; width: 3px; margin-left: -1.5px; }
  .mem-faq__item[open] .mem-faq__icon::after { transform: scaleY(0); }
  .mem-faq__a { padding: 0 4px 24px; font-size: 18px; line-height: 1.7; color: var(--mem-text-mid); }
  .mem-faq__a p { margin: 0 0 12px; }
  .mem-faq__a p:last-child { margin-bottom: 0; }
  .mem-faq__a a { color: var(--mem-green); }
  @media (max-width: 749px) {
    .mem-faq__q { font-size: 20px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Membership: FAQ",
  "tag": "div",
  "class": "ncdr-mem-faq-section",
  "settings": [
    { "type": "paragraph", "content": "Tick \"Placeholder answer\" on a question to show a yellow PLACEHOLDER tag until the answer is confirmed. Tokens: [PLAN NAME], [NOTICE PERIOD], [BILLING PARTNER]." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Membership FAQ" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does billing work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" },
        { "type": "checkbox", "id": "placeholder", "label": "Placeholder answer (shows a PLACEHOLDER tag)", "default": true }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Membership: FAQ" }]
}
{% endschema %}
