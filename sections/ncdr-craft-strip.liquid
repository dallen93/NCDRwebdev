<style>
  .ncdr-craft-strip {
    padding: 80px 60px;
    background: #fff;
    text-align: center;
    border-top: 1px solid var(--ncdr-light-gray);
  }

  .ncdr-craft-strip__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .ncdr-craft-strip__eyebrow::before,
  .ncdr-craft-strip__eyebrow::after {
    content: '';
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--ncdr-gold);
    opacity: 0.4;
  }

  .ncdr-craft-strip__heading {
    font-family: var(--ncdr-font-heading);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    color: var(--ncdr-green-deep);
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .ncdr-craft-strip__sub {
    font-size: 16px;
    color: var(--ncdr-text-mid);
    font-weight: 300;
    margin: 0 auto 48px;
    max-width: 480px;
  }

  /* Two-column grid — centred when only 2 tiles */
  .ncdr-craft-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
  }

  /* Story tile */
  .ncdr-story-tile {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
    background: #1b2212;
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }
  .ncdr-story-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.30);
  }

  /* Rich dark olive gradient (matches screenshot) */
  .ncdr-story-tile__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      #2a3318 0%,
      #1b2212 40%,
      #0e1409 100%
    );
    z-index: 0;
  }

  /* Optional background image with heavy dark overlay */
  .ncdr-story-tile__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ncdr-story-tile__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ncdr-story-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 15, 7, 0.95) 0%,
      rgba(10, 15, 7, 0.75) 45%,
      rgba(10, 15, 7, 0.50) 100%
    );
    z-index: 1;
  }

  /* Gold logo badge — top-right */
  .ncdr-story-tile__logo-wrap {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--ncdr-gold);
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    background: rgba(0,0,0,0.20);
  }
  .ncdr-story-tile__logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .ncdr-story-tile__content {
    position: relative;
    z-index: 2;
    padding: 28px 28px 30px;
    text-align: left;
  }

  .ncdr-story-tile__brand {
    font-family: var(--ncdr-font-heading);
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ncdr-gold);
    margin-bottom: 10px;
    line-height: 1;
  }

  .ncdr-story-tile__tagline {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 20px;
    font-weight: 400;
    color: rgba(255,255,255,0.88);
    line-height: 1.45;
    margin-bottom: 20px;
  }

  .ncdr-story-tile__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ncdr-font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    border-bottom: 1px solid rgba(180,148,76,0.4);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }
  .ncdr-story-tile:hover .ncdr-story-tile__link {
    border-color: var(--ncdr-gold);
  }

  @media (max-width: 749px) {
    .ncdr-craft-strip { padding: 56px 20px; }
    .ncdr-craft-strip__grid {
      grid-template-columns: 1fr;
      max-width: 100%;
    }
    .ncdr-story-tile { min-height: 340px; }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&display=swap" rel="stylesheet">

<div class="ncdr-craft-strip">
  <div class="ncdr-craft-strip__eyebrow">{{ section.settings.eyebrow | default: 'Craftsmanship' }}</div>
  <h2 class="ncdr-craft-strip__heading">{{ section.settings.heading }}</h2>
  <p class="ncdr-craft-strip__sub">{{ section.settings.subtext }}</p>

  <div class="ncdr-craft-strip__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.story_link | default: '#' }}" class="ncdr-story-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.bg_image != blank -%}
          <div class="ncdr-story-tile__bg">
            <img
              src="{{ block.settings.bg_image | image_url: width: 900 }}"
              alt="{{ block.settings.brand_name }}"
              loading="lazy"
              width="900"
              height="700"
            >
          </div>
          <div class="ncdr-story-tile__overlay"></div>
        {%- else -%}
          <div class="ncdr-story-tile__gradient"></div>
        {%- endif -%}

        {%- if block.settings.logo != blank -%}
          <div class="ncdr-story-tile__logo-wrap">
            <img
              src="{{ block.settings.logo | image_url: width: 200 }}"
              alt="{{ block.settings.brand_name }} logo"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        <div class="ncdr-story-tile__content">
          <div class="ncdr-story-tile__brand">{{ block.settings.brand_name }}</div>
          <div class="ncdr-story-tile__tagline">{{ block.settings.tagline }}</div>
          <div class="ncdr-story-tile__link">Read the {{ block.settings.brand_name }} story →</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "NCDR Craft Strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Craftsmanship" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted by hand. Chosen by few." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Northcrest is an authorized dealer for each of these makers." }
  ],
  "blocks": [
    {
      "type": "brand_story",
      "name": "Brand Story Tile",
      "settings": [
        { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
        { "type": "image_picker", "id": "logo", "label": "Brand logo (white/transparent PNG)" },
        { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Honma" },
        { "type": "text", "id": "tagline", "label": "Italic tagline", "default": "A heritage of excellence." },
        { "type": "url", "id": "story_link", "label": "Story page link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NCDR Craft Strip",
      "blocks": [
        {
          "type": "brand_story",
          "settings": {
            "brand_name": "Majesty",
            "tagline": "Precision refined for the discerning golfer."
          }
        },
        {
          "type": "brand_story",
          "settings": {
            "brand_name": "Honma",
            "tagline": "A heritage of excellence."
          }
        }
      ]
    }
  ]
}
{% endschema %}
