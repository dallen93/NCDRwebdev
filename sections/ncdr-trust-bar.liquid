<style>
  .ncdr-trust-bar {
    padding: 48px 60px;
    background: #fff;
    border-bottom: 1px solid var(--ncdr-light-gray);
    text-align: center;
    overflow: hidden;
  }

  .ncdr-trust-bar__eyebrow {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ncdr-mid-gray);
    margin-bottom: 36px;
  }

  /* ── Three authorized dealer badges ── */
  .ncdr-trust-bar__dealers {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    align-items: stretch;
    margin-bottom: 40px;
  }

  .ncdr-trust-bar__dealer-card {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 220px;
    /* Fixed-height image frame — every badge reads the same visual weight */
    height: 140px;
    padding: 20px 24px;
    border: 1px solid var(--ncdr-light-gray);
    border-radius: 6px;
    background: #fff;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ncdr-trust-bar__dealer-card:hover {
    transform: translateY(-3px);
    border-color: var(--ncdr-gold);
    box-shadow: 0 8px 24px rgba(58,88,43,0.08);
    text-decoration: none;
  }

  /* Uniform logo sizing — fill the card frame then scale down */
  .ncdr-trust-bar__dealer-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(0.75);
  }

  .ncdr-trust-bar__dealer-card {
    overflow: hidden;
  }

  /* Honma PNG has heavy surrounding whitespace — zoom in to compensate */
  .ncdr-trust-bar__dealer-card--honma {
    overflow: hidden;
  }
  .ncdr-trust-bar__dealer-card--honma img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.5);
  }

  /* ── Carried brands strip ── */
  .ncdr-trust-bar__brands {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .ncdr-trust-bar__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 80px;
    /* Fixed-height frame — same approach as dealer cards */
    height: 48px;
    padding: 0 20px;
    border-right: 1px solid var(--ncdr-light-gray);
    text-decoration: none;
  }

  .ncdr-trust-bar__brand:last-child {
    border-right: none;
  }

  .ncdr-trust-bar__brand img {
    display: block;
    height: 22px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(100%) opacity(0.45);
    transition: filter 0.2s ease;
  }

  .ncdr-trust-bar__brand:hover img {
    filter: grayscale(0%) opacity(1);
  }

  /* Per-brand size overrides */
  .ncdr-trust-bar__brand--sm img { height: 19px; }
  .ncdr-trust-bar__brand--lg img { height: 32px; }

  @media (max-width: 749px) {
    .ncdr-trust-bar {
      padding: 40px 20px;
    }

    .ncdr-trust-bar__dealers {
      gap: 16px;
      margin-bottom: 32px;
    }

    .ncdr-trust-bar__dealer-card {
      width: calc(50% - 8px);
      height: 110px;
      padding: 16px;
    }

    .ncdr-trust-bar__brand {
      height: 40px;
      padding: 0 12px;
      border-right: none;
      border-bottom: 1px solid var(--ncdr-light-gray);
      width: 50%;
      flex: 0 0 50%;
    }

    .ncdr-trust-bar__brand:nth-child(odd) {
      border-right: 1px solid var(--ncdr-light-gray);
    }

    .ncdr-trust-bar__brand:last-child,
    .ncdr-trust-bar__brand:nth-last-child(2):nth-child(odd) {
      border-bottom: none;
    }
  }
</style>

<div class="ncdr-trust-bar">
  {%- if section.settings.eyebrow != blank -%}
    <p class="ncdr-trust-bar__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}

  <!-- Authorized dealer badges: Majesty · Honma · XXIO -->
  <div class="ncdr-trust-bar__dealers">
    <a href="{{ section.settings.majesty_link | default: '/collections/majesty' }}" class="ncdr-trust-bar__dealer-card">
      <img
        src="{{ 'brand-majesty.png' | asset_url }}"
        alt="Majesty Golf — Authorized Dealer"
        loading="lazy"
      >
    </a>
    <a href="{{ section.settings.honma_link | default: '/collections/honma' }}" class="ncdr-trust-bar__dealer-card ncdr-trust-bar__dealer-card--honma">
      <img
        src="{{ 'brand-honma.png' | asset_url }}"
        alt="Honma — Authorized Retailer"
        loading="lazy"
      >
    </a>
    <a href="/collections/xxio" class="ncdr-trust-bar__dealer-card">
      <img
        src="{{ 'brand-xxio.jpeg' | asset_url }}"
        alt="XXIO"
        loading="lazy"
      >
    </a>
  </div>

  <!-- Carried brands strip -->
  <!-- NOTE: Callaway and Mizuno are hidden pending receipt of corrected logo files.
       To restore, uncomment the two blocks below. -->
  <div class="ncdr-trust-bar__brands">
    <a href="/collections/taylormade" class="ncdr-trust-bar__brand ncdr-trust-bar__brand--sm">
      <img src="{{ 'brand-taylormade.svg' | asset_url }}" alt="TaylorMade" loading="lazy">
    </a>
    <a href="/collections/cleveland" class="ncdr-trust-bar__brand ncdr-trust-bar__brand--lg">
      <!-- brand-cleveland.png: upload corrected file to restore -->
      <img src="{{ 'brand-cleveland.png' | asset_url }}" alt="Cleveland Golf" loading="lazy">
    </a>
    <a href="/collections/srixon" class="ncdr-trust-bar__brand">
      <img src="{{ 'brand-srixon.svg' | asset_url }}" alt="Srixon" loading="lazy">
    </a>
    <a href="/collections/callaway" class="ncdr-trust-bar__brand ncdr-trust-bar__brand--sm">
      <img src="{{ 'brand-callaway.svg' | asset_url }}" alt="Callaway" loading="lazy">
    </a>
    {%- comment -%}
    PENDING: Mizuno logo — awaiting official asset from brand
    <a href="/collections/mizuno" class="ncdr-trust-bar__brand">
      <img src="{{ 'brand-mizuno.png' | asset_url }}" alt="Mizuno" loading="lazy">
    </a>
    {%- endcomment -%}
    <a href="/collections/ogio" class="ncdr-trust-bar__brand ncdr-trust-bar__brand--sm">
      <img src="{{ 'brand-ogio.svg' | asset_url }}" alt="OGIO" loading="lazy">
    </a>
    <a href="/collections/mu-sports" class="ncdr-trust-bar__brand">
      <img src="{{ 'brand-mu-sports.png' | asset_url }}" alt="MU Sports" loading="lazy">
    </a>
    <a href="/collections/yonex" class="ncdr-trust-bar__brand ncdr-trust-bar__brand--sm">
      <img src="{{ 'brand-yonex.svg' | asset_url }}" alt="Yonex" loading="lazy">
    </a>
  </div>
</div>

{% schema %}
{
  "name": "NCDR Trust Bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label (leave blank to hide)"
    },
    {
      "type": "url",
      "id": "majesty_link",
      "label": "Majesty collection link"
    },
    {
      "type": "url",
      "id": "honma_link",
      "label": "Honma collection link"
    }
  ],
  "presets": [
    { "name": "NCDR Trust Bar" }
  ]
}
{% endschema %}
