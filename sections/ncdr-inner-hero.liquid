<style>
  .ncdr-inner-hero {
    background: var(--ncdr-green-deep);
    padding: 56px 60px 48px;
    position: relative;
    overflow: hidden;
  }

  .ncdr-inner-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      rgba(255,255,255,0.012) 0px,
      rgba(255,255,255,0.012) 1px,
      transparent 1px,
      transparent 28px
    );
    pointer-events: none;
  }

  .ncdr-inner-hero__content {
    position: relative;
    z-index: 2;
    max-width: 680px;
  }

  .ncdr-inner-hero__eyebrow {
    font-family: var(--ncdr-font-heading);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ncdr-gold);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ncdr-inner-hero__eyebrow::after {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--ncdr-gold);
    opacity: 0.4;
  }

  .ncdr-inner-hero__heading {
    font-family: var(--ncdr-font-heading) !important;
    font-size: 48px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    line-height: 1.0;
    margin-bottom: 14px;
    letter-spacing: 0.02em;
  }

  .ncdr-inner-hero__heading span {
    color: var(--ncdr-gold);
    display: block;
  }

  .ncdr-inner-hero__sub {
    font-size: 15px;
    color: rgba(255,255,255,0.6);
    max-width: 480px;
    line-height: 1.7;
    font-weight: 300;
    margin: 0;
  }

  /* Hero image mode */
  .ncdr-inner-hero--has-image {
    padding: 0;
    min-height: 380px;
    display: flex;
    align-items: flex-end;
  }

  .ncdr-inner-hero__image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ncdr-inner-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .ncdr-inner-hero__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20,38,14,0.85) 0%, rgba(20,38,14,0.3) 60%, transparent 100%);
    z-index: 1;
  }

  .ncdr-inner-hero--has-image .ncdr-inner-hero__content {
    padding: 48px 60px;
    z-index: 2;
    width: 100%;
    max-width: 100%;
  }

  @media (max-width: 749px) {
    .ncdr-inner-hero { padding: 40px 20px 36px; }
    .ncdr-inner-hero__heading { font-size: 32px; }
    .ncdr-inner-hero--has-image .ncdr-inner-hero__content { padding: 36px 20px; }
  }
</style>

{%- comment -%}
  Metafield-driven content: if the collection has custom metafields set,
  those take priority. Falls back to section settings for non-brand collections.
{%- endcomment -%}

{%- assign mf_eyebrow     = collection.metafields.custom.hero_eyebrow.value -%}
{%- assign mf_heading     = collection.metafields.custom.hero_heading.value -%}
{%- assign mf_heading_gold = collection.metafields.custom.hero_heading_gold.value -%}
{%- assign mf_subtext     = collection.metafields.custom.hero_subtext.value -%}
{%- assign mf_image       = collection.metafields.custom.hero_image.value -%}

{%- assign hero_eyebrow      = mf_eyebrow      | default: section.settings.eyebrow -%}
{%- assign hero_heading      = mf_heading      | default: section.settings.heading -%}
{%- assign hero_heading_gold = mf_heading_gold | default: section.settings.heading_gold -%}
{%- assign hero_subtext      = mf_subtext      | default: section.settings.subtext -%}
{%- assign hero_image        = mf_image -%}

<div class="ncdr-inner-hero{% if hero_image != blank %} ncdr-inner-hero--has-image{% endif %}">

  {%- if hero_image != blank -%}
    <div class="ncdr-inner-hero__image">
      {{ hero_image | image_url: width: 2000 | image_tag: loading: 'eager', alt: hero_heading }}
    </div>
    <div class="ncdr-inner-hero__image-overlay"></div>
  {%- endif -%}

  <div class="ncdr-inner-hero__content">
    {%- if hero_eyebrow != blank -%}
      <div class="ncdr-inner-hero__eyebrow">{{ hero_eyebrow }}</div>
    {%- endif -%}
    <h1 class="ncdr-inner-hero__heading">
      {{ hero_heading }}
      {%- if hero_heading_gold != blank -%}
        <span>{{ hero_heading_gold }}</span>
      {%- endif -%}
    </h1>
    {%- if hero_subtext != blank -%}
      <p class="ncdr-inner-hero__sub">{{ hero_subtext }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NCDR Inner Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_gold", "label": "Heading line 2 (gold, optional)" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" }
  ],
  "presets": [
    { "name": "NCDR Inner Hero" }
  ]
}
{% endschema %}
