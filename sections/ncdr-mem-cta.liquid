{%- comment -%}
  Membership page — 6. Closing call to action
  Join button (opens the sign-up pop-up) when Launch mode is Live,
  Notify me form when Launch mode is Coming soon.
  Tokens: [PLAN NAME], [MONTHLY PRICE].
{%- endcomment -%}
{% render 'ncdr-mem-assets' %}

{%- liquid
  assign launch = settings.mem_launch_mode | default: 'coming_soon'
  assign monthly_fmt = settings.mem_monthly_price | times: 100 | money_without_trailing_zeros
  assign plan_name = settings.mem_plan_name | escape
  assign subtext = section.settings.subtext | escape | replace: '[MONTHLY PRICE]', monthly_fmt | replace: '[PLAN NAME]', plan_name | newline_to_br
-%}

<section class="mem mem-section mem-section--green mem-center mem-cta" id="mem-join" aria-labelledby="mem-cta-heading-{{ section.id }}">
  <div class="mem-wrap mem-cta__inner">
    <h2 class="mem-h2 mem-cta__heading" id="mem-cta-heading-{{ section.id }}">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_accent != blank -%}
        <span class="mem-accent mem-cta__accent">{{ section.settings.heading_accent | escape }}</span>
      {%- endif -%}
    </h2>
    {%- if subtext != blank -%}
      <p class="mem-sub">{{ subtext }}</p>
    {%- endif -%}

    {%- if launch == 'live' -%}
      <div class="mem-btns">
        <a href="#mem-plan" class="mem-btn mem-btn--gold" data-mem-open aria-haspopup="dialog">{{ section.settings.join_label | escape }}</a>
      </div>
    {%- else -%}
      <div class="mem-cta__notify">
        {%- render 'ncdr-mem-notify',
          form_id: section.id,
          button_label: section.settings.notify_button,
          placeholder: section.settings.notify_placeholder,
          success: section.settings.notify_success,
          note: settings.mem_launch_note
        -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .mem-cta { position: relative; overflow: hidden; }
  .mem-cta::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .07;
    background-image: radial-gradient(var(--mem-gold) 1.5px, transparent 1.5px); background-size: 28px 28px;
  }
  .mem-cta__inner { position: relative; z-index: 1; max-width: 760px; }
  .mem-cta__accent { display: block; font-size: .7em; line-height: 1.25; margin-top: 8px; }
  .mem-cta__notify { max-width: 520px; margin: 0 auto; }
{% endstyle %}

{% schema %}
{
  "name": "Membership: Closing CTA",
  "tag": "div",
  "class": "ncdr-mem-cta-section",
  "settings": [
    { "type": "paragraph", "content": "Join button vs. Notify me form follows Theme settings → Northcrest Membership → Launch mode. Tokens: [PLAN NAME], [MONTHLY PRICE]." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for member pricing?" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic, second line)", "default": "Your next basket could cost less." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Join online in a few minutes. Your digital card is ready for your next visit.", "info": "Press Enter for a line break." },
    { "type": "text", "id": "join_label", "label": "Join button label (Live mode)", "default": "Join now", "info": "Opens the sign-up pop-up." },
    { "type": "header", "content": "When launch mode is Coming soon" },
    { "type": "text", "id": "notify_placeholder", "label": "Email field placeholder", "default": "Your email address" },
    { "type": "text", "id": "notify_button", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "notify_success", "label": "Confirmation message", "default": "You're on the list. We'll email you when membership opens." }
  ],
  "presets": [{ "name": "Membership: Closing CTA" }]
}
{% endschema %}
