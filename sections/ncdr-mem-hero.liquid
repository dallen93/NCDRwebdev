{%- comment -%}
  Membership page — 1. Hero
  Join buttons vs. the Notify me form follow Theme settings → Northcrest Membership → Launch mode.
  Tokens you can type in the text fields: [PLAN NAME], [MONTHLY PRICE].
{%- endcomment -%}
{% render 'ncdr-mem-assets' %}

{%- liquid
  assign launch = settings.mem_launch_mode | default: 'coming_soon'
  assign monthly_price = settings.mem_monthly_price | times: 100 | money_without_trailing_zeros
  assign plan_name = settings.mem_plan_name | escape
  assign price_line = section.settings.price_line | escape | replace: '[MONTHLY PRICE]', monthly_price | replace: '[PLAN NAME]', plan_name
  assign subtext = section.settings.subtext | escape | replace: '[MONTHLY PRICE]', monthly_price | replace: '[PLAN NAME]', plan_name
  assign overlay = section.settings.image_overlay | divided_by: 100.0
-%}

<section class="mem mem-section mem-section--green mem-center mem-hero" id="mem-hero" aria-labelledby="mem-hero-heading-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="mem-hero__media" aria-hidden="true">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000', alt: '' }}
      <span class="mem-hero__scrim" style="opacity: {{ overlay }};"></span>
    </div>
  {%- endif -%}

  <div class="mem-wrap mem-hero__inner">
    {%- if request.design_mode -%}
      <p class="mem-hero__editor-note">Launch mode: <strong>{% if launch == 'live' %}Live{% else %}Coming soon{% endif %}</strong> · change it in Theme settings → Northcrest Membership. (Only shown in the editor.)</p>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="mem-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="mem-h1 mem-hero__heading" id="mem-hero-heading-{{ section.id }}">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_accent != blank -%}
        <span class="mem-accent mem-hero__accent">{{ section.settings.heading_accent | escape }}</span>
      {%- endif -%}
    </h1>

    {%- if subtext != blank -%}
      <p class="mem-sub mem-hero__sub">{{ subtext }}</p>
    {%- endif -%}

    {%- if launch == 'live' -%}
      {%- if price_line != blank -%}
        <p class="mem-hero__price">{{ price_line }}</p>
      {%- endif -%}
      <div class="mem-btns">
        <a
          href="#mem-plan"
          class="mem-btn mem-btn--gold"
          data-mem-open
          aria-haspopup="dialog"
        >{{ section.settings.join_label | escape }}</a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_anchor | default: '#mem-pricing' | escape }}" class="mem-btn mem-btn--ghost">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="mem-hero__notify">
        {%- render 'ncdr-mem-notify',
          form_id: section.id,
          button_label: section.settings.notify_button,
          placeholder: section.settings.notify_placeholder,
          success: section.settings.notify_success,
          note: settings.mem_launch_note
        -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .mem-hero { position: relative; overflow: hidden; min-height: 560px; display: flex; align-items: center; justify-content: center; padding-top: 104px; padding-bottom: 104px; }
  .mem-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .07;
    background-image: radial-gradient(var(--mem-gold) 1.5px, transparent 1.5px); background-size: 28px 28px;
  }
  .mem-hero__media { position: absolute; inset: 0; }
  .mem-hero__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mem-hero__scrim { position: absolute; inset: 0; display: block; background: var(--mem-green-deep); }
  .mem-hero__inner { position: relative; z-index: 1; max-width: 820px; }
  .mem-hero__heading { margin-bottom: 22px; }
  .mem-hero__accent { display: block; font-size: .62em; line-height: 1.2; margin-top: 10px; }
  .mem-hero__sub { font-size: 22px; margin-bottom: 30px; }
  .mem-hero__price { font-family: var(--mem-font-head); font-size: 22px; letter-spacing: .05em; text-transform: uppercase; color: var(--mem-white); margin: 0 0 26px; }
  .mem-hero__notify { max-width: 520px; margin: 0 auto; }
  .mem-hero__editor-note { display: inline-block; background: #fff4cc; color: #3d2f00; font-size: 15px; padding: 6px 12px; border-radius: 2px; margin: 0 0 24px; }
  @media (max-width: 749px) {
    .mem-hero { min-height: 0; padding-top: 72px; padding-bottom: 72px; }
    .mem-hero__sub { font-size: 19px; }
    .mem-hero__price { font-size: 19px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Membership: Hero",
  "tag": "div",
  "class": "ncdr-mem-hero-section",
  "settings": [
    { "type": "paragraph", "content": "Join button vs. Notify me form follows Theme settings → Northcrest Membership → Launch mode. You can type [PLAN NAME] or [MONTHLY PRICE] in the text fields." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Northcrest Membership" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Practice more." },
    { "type": "text", "id": "heading_accent", "label": "Headline accent (italic, second line)", "default": "Pay less for every basket." },
    { "type": "textarea", "id": "subtext", "label": "Member pricing line", "default": "Members get a lower price on every range basket, every visit. Just show your digital card at the counter." },
    { "type": "header", "content": "When launch mode is Live" },
    { "type": "text", "id": "price_line", "label": "Price line", "default": "[PLAN NAME] · [MONTHLY PRICE] a month", "info": "Leave blank to hide." },
    { "type": "text", "id": "join_label", "label": "Join button label", "default": "Join now", "info": "Opens the sign-up pop-up." },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "See what you save", "info": "Leave blank to hide." },
    { "type": "text", "id": "secondary_anchor", "label": "Second button link", "default": "#mem-pricing", "info": "#mem-pricing jumps to the price comparison table." },
    { "type": "header", "content": "When launch mode is Coming soon" },
    { "type": "text", "id": "notify_placeholder", "label": "Email field placeholder", "default": "Your email address" },
    { "type": "text", "id": "notify_button", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "notify_success", "label": "Confirmation message", "default": "Almost there! Check your email and confirm to join the waitlist." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "image_overlay", "label": "Green overlay on image", "min": 40, "max": 95, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "Membership: Hero" }]
}
{% endschema %}
