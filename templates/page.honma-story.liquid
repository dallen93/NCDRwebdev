{% layout 'theme' %}

{%- comment -%} Honma Beres 10 — Brand Story Page {%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

<style>
  /* ── HERO ── */
  .ncdr-bs-hero{position:relative;height:70vh;min-height:460px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0a0f07}
  .ncdr-bs-hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .ncdr-bs-hero__overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(5,9,3,.80) 0%,rgba(5,9,3,.35) 50%,rgba(5,9,3,.15) 100%);z-index:1}
  .ncdr-bs-hero__content{position:relative;z-index:2;text-align:center;padding:0 40px;max-width:860px}
  .ncdr-bs-hero__heading{font-family:'Playfair Display',Georgia,serif;font-size:clamp(44px,7vw,88px);font-weight:700;letter-spacing:.04em;color:#fff;line-height:1.05;margin-bottom:18px}
  .ncdr-bs-hero__sub{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:clamp(14px,1.8vw,20px);color:rgba(255,255,255,.78);letter-spacing:.14em;text-transform:uppercase}

  /* ── STATEMENT ── */
  .ncdr-bs-statement{padding:52px 60px;background:#fff;text-align:center}
  .ncdr-bs-statement__heading{font-family:var(--ncdr-font-heading);font-size:clamp(24px,3.5vw,38px);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ncdr-green-deep);margin:0 auto 28px;line-height:1.15;max-width:1100px;white-space:nowrap}
  .ncdr-bs-statement__body{font-size:18px;color:var(--ncdr-text-dark);font-weight:300;line-height:1.85;max-width:1100px;margin:0 auto}

  /* ── FEATURE CARDS — full-bleed image, light hover overlay ── */
  .ncdr-bs-features{padding:64px 60px;background:#e8eae6}
  .ncdr-bs-features__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1100px;margin:0 auto}

  .ncdr-bs-fcard{position:relative;border-radius:2px;overflow:hidden;background:#f5f3ef;border:3px solid #000;cursor:default;aspect-ratio:1/1}
  .ncdr-bs-fcard__img{position:absolute;inset:0}
  .ncdr-bs-fcard__img img{width:100%;height:100%;object-fit:contain;object-position:center;display:block;transition:transform .5s ease,opacity .4s ease}
  .ncdr-bs-fcard:hover .ncdr-bs-fcard__img img{transform:scale(1.03);opacity:.32}

  /* Overlay kept for stacking context — transparent */
  .ncdr-bs-fcard__overlay{position:absolute;inset:0;z-index:1;pointer-events:none}

  /* Text — centered, revealed on hover */
  .ncdr-bs-fcard__body{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease;pointer-events:none}
  .ncdr-bs-fcard:hover .ncdr-bs-fcard__body{opacity:1;transform:translateY(0)}

  .ncdr-bs-fcard__title{font-family:var(--ncdr-font-heading);font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#111;margin-bottom:8px;line-height:1.2;text-align:center}
  .ncdr-bs-fcard__text{font-size:12px;color:#333;font-weight:400;line-height:1.7;text-align:center}

  /* ── HERITAGE SPLIT ── */
  .ncdr-bs-heritage{display:grid;grid-template-columns:1fr 1fr;min-height:560px;background:#fff}
  .ncdr-bs-heritage__text{padding:80px 64px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid var(--ncdr-light-gray)}
  .ncdr-bs-heritage__eyebrow{font-size:18px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--ncdr-gold);margin-bottom:24px;display:flex;align-items:center;gap:10px}
  .ncdr-bs-heritage__eyebrow::after{content:'';display:inline-block;width:32px;height:1px;background:var(--ncdr-gold);opacity:.4}
  .ncdr-bs-heritage__para{font-size:16px;color:var(--ncdr-text-dark);font-weight:300;line-height:1.9;margin-bottom:40px}
  .ncdr-bs-heritage__para .gold,.ncdr-bs-heritage__display .gold{color:var(--ncdr-gold);font-weight:600}
  .ncdr-bs-heritage__display{font-family:var(--ncdr-font-heading);font-size:clamp(28px,4vw,44px);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ncdr-green-deep);line-height:1.1}
  .ncdr-bs-heritage__photo{position:relative;overflow:hidden;background:var(--ncdr-green-deep)}
  .ncdr-bs-heritage__photo img{width:100%;height:100%;object-fit:cover;display:block}

  /* ── CTA BAND ── */
  .ncdr-bs-cta{position:relative;min-height:480px;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:#1a1208}
  .ncdr-bs-cta__bg{position:absolute;inset:0;z-index:0}
  .ncdr-bs-cta__bg img{width:100%;height:100%;object-fit:cover;display:block}
  /* Vignette: dark edges, lighter center */
  .ncdr-bs-cta__overlay{display:none}
  .ncdr-bs-cta__content{position:relative;z-index:2;padding:80px 48px;max-width:760px}
  .ncdr-bs-cta__heading{font-family:'Playfair Display',Georgia,serif;font-size:clamp(28px,4.5vw,52px);font-weight:700;color:#fff;line-height:1.1;margin-bottom:20px;letter-spacing:.01em}
  .ncdr-bs-cta__sub{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:clamp(14px,1.6vw,18px);color:var(--ncdr-gold);font-weight:400;line-height:1.7;margin-bottom:40px;max-width:560px;margin-left:auto;margin-right:auto}
  .ncdr-bs-cta__buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  /* Call button — gold fill */
  .ncdr-bs-cta__btn{font-family:var(--ncdr-font-heading);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:16px 36px;border-radius:2px;text-decoration:none;transition:all .25s;background:var(--ncdr-gold);color:#1a1208;border:1.5px solid var(--ncdr-gold)}
  .ncdr-bs-cta__btn:hover{background:#c9a84c;border-color:#c9a84c;color:#1a1208}
  /* Message button — dark fill */
  .ncdr-bs-cta__btn--outline{background:rgba(15,10,4,.82);color:#fff;border:1.5px solid rgba(15,10,4,.82)}
  .ncdr-bs-cta__btn--outline:hover{background:rgba(15,10,4,1);border-color:rgba(15,10,4,1);color:#fff}

  /* ── RESPONSIVE ── */
  @media(max-width:989px){
    .ncdr-bs-heritage{grid-template-columns:1fr}
    .ncdr-bs-heritage__text{border-right:none;border-bottom:1px solid var(--ncdr-light-gray);padding:60px 32px}
    .ncdr-bs-heritage__photo{min-height:340px}
    .ncdr-bs-features__grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:749px){
    .ncdr-bs-hero{height:100svh}
    .ncdr-bs-hero__content{padding:0 24px 60px}
    .ncdr-bs-statement{padding:64px 24px}
    .ncdr-bs-statement__heading{white-space:normal}
    .ncdr-bs-features{padding:48px 20px}
    .ncdr-bs-features__grid{grid-template-columns:1fr;gap:16px}
    .ncdr-bs-fcard{aspect-ratio:4/3;border:none}
    .ncdr-bs-heritage__text{padding:48px 24px}
    .ncdr-bs-cta__content{padding:60px 24px}
  }
</style>

<!-- HERO -->
<div class="ncdr-bs-hero">
  <video autoplay muted loop playsinline>
    <source src="https://cdn.shopify.com/videos/c/o/v/93e6c3f958144be3b04cdbaabf264439.mp4" type="video/mp4">
  </video>
  <div class="ncdr-bs-hero__overlay"></div>
  <div class="ncdr-bs-hero__content">
    <h1 class="ncdr-bs-hero__heading">HONMA BERES 10</h1>
    <p class="ncdr-bs-hero__sub">Handcrafted in Sakata. Available at Northcrest.</p>
  </div>
</div>

<!-- STATEMENT -->
<div class="ncdr-bs-statement">
  <h2 class="ncdr-bs-statement__heading">Where Mastery Meets Performance</h2>
  <p class="ncdr-bs-statement__body">Honma's Beres 10 Series represents the tenth generation of Japan's most revered golf club collection. Hand-finished by master Takumi craftsmen in Sakata, each club blends traditional artistry inspired by Edo Kiriko glass-cutting techniques with advanced materials engineered for effortless power and precision. Northcrest is honored to present this exceptional collection.</p>
</div>

<!-- FEATURE CARDS -->
<div class="ncdr-bs-features">
  <div class="ncdr-bs-features__grid">
    <div class="ncdr-bs-fcard">
      <div class="ncdr-bs-fcard__img">
        <img src="{{ 'Why Honma_1.webp' | asset_url }}" alt="Pure Speed Engine" loading="lazy">
      </div>
      <div class="ncdr-bs-fcard__overlay"></div>
      <div class="ncdr-bs-fcard__body">
        <div class="ncdr-bs-fcard__title">Pure Speed Engine</div>
        <p class="ncdr-bs-fcard__text">Full titanium frame construction and variable thickness face technology create exceptional ball speed and distance across the entire clubface, delivering effortless power with every swing.</p>
      </div>
    </div>
    <div class="ncdr-bs-fcard">
      <div class="ncdr-bs-fcard__img">
        <img src="{{ 'Why Honma_2.webp' | asset_url }}" alt="Artistry in Motion" loading="lazy">
      </div>
      <div class="ncdr-bs-fcard__overlay"></div>
      <div class="ncdr-bs-fcard__body">
        <div class="ncdr-bs-fcard__title">Artistry in Motion</div>
        <p class="ncdr-bs-fcard__text">Laser-cut Kiriko patterns and 3D emblem structures inspired by 1834 Japanese glass-cutting traditions create visual depth while suppressing unwanted vibration for premium feel and acoustics.</p>
      </div>
    </div>
    <div class="ncdr-bs-fcard">
      <div class="ncdr-bs-fcard__img">
        <img src="{{ 'Why Honma_3.webp' | asset_url }}" alt="Weightless Precision" loading="lazy">
      </div>
      <div class="ncdr-bs-fcard__overlay"></div>
      <div class="ncdr-bs-fcard__body">
        <div class="ncdr-bs-fcard__title">Weightless Precision</div>
        <p class="ncdr-bs-fcard__text">ARMRQ Flight shafts featuring 5-axis hybrid metal mesh with TORAYCA T1100G carbon fiber deliver improved impact efficiency and remarkable stability at weights as low as 45 grams.</p>
      </div>
    </div>
  </div>
</div>

<!-- HERITAGE SPLIT -->
<div class="ncdr-bs-heritage">
  <div class="ncdr-bs-heritage__text">
    <div class="ncdr-bs-heritage__eyebrow">Heritage</div>
    <p class="ncdr-bs-heritage__para">For over 65 years, Honma has crafted the world's most <span class="gold">luxurious</span> golf equipment in their Sakata studio. The Beres Collection has long been recognized globally as the choice of golfers who value craftsmanship at its most <span class="gold">elevated</span> level. Northcrest offers personalized guidance to help you experience the refinement, balance, and performance that define Beres 10.</p>
    <div class="ncdr-bs-heritage__display">A HERITAGE OF <span class="gold">EXCELLENCE</span></div>
  </div>
  <div class="ncdr-bs-heritage__photo">
    <img src="{{ 'Honma_Rare Partnership_1.webp' | asset_url }}" alt="Honma heritage" loading="lazy">
  </div>
</div>

<!-- CTA BAND -->
<div class="ncdr-bs-cta">
  <div class="ncdr-bs-cta__bg">
    <img src="{{ 'Honma CTA_Sharing Club.png' | asset_url }}" alt="Book a consultation" loading="lazy">
  </div>
  <div class="ncdr-bs-cta__overlay"></div>
  <div class="ncdr-bs-cta__content">
    <h2 class="ncdr-bs-cta__heading">Experience It for Yourself</h2>
    <p class="ncdr-bs-cta__sub">Personalized fittings available at Northcrest</p>
    <div class="ncdr-bs-cta__buttons">
      <a href="tel:7707230002" class="ncdr-bs-cta__btn">Call the Pro Shop</a>
      <a href="/pages/contact" class="ncdr-bs-cta__btn ncdr-bs-cta__btn--outline">Message the Pro Shop</a>
    </div>
  </div>
</div>
