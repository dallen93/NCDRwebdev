{% layout 'theme' %}

{%- comment -%} Majesty Prestigio 14 — Brand Story Page {%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

<style>
  /* ── HERO ── */
  .ncdr-bs-hero{position:relative;height:70vh;min-height:460px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0a0f07}
  .ncdr-bs-hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  .ncdr-bs-hero__overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(5,9,3,.80) 0%,rgba(5,9,3,.35) 50%,rgba(5,9,3,.15) 100%);z-index:1}
  .ncdr-bs-hero__content{position:relative;z-index:2;text-align:center;padding:0 40px;max-width:860px}
  .ncdr-bs-hero__heading{font-family:'Playfair Display',Georgia,serif;font-size:clamp(44px,7vw,88px);font-weight:700;letter-spacing:.04em;color:#fff;line-height:1.05;margin-bottom:18px}
  .ncdr-bs-hero__sub{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-size:clamp(14px,1.8vw,20px);color:rgba(255,255,255,.78);letter-spacing:.14em;text-transform:uppercase}

  /* ── STATEMENT ── */
  .ncdr-bs-statement{padding:100px 60px;background:#fff;text-align:center}
  .ncdr-bs-statement__heading{font-family:var(--ncdr-font-heading);font-size:clamp(24px,3.5vw,38px);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ncdr-green-deep);margin:0 auto 28px;line-height:1.15;max-width:700px}
  .ncdr-bs-statement__body{font-size:18px;color:var(--ncdr-text-dark);font-weight:300;line-height:1.85;max-width:680px;margin:0 auto}

  /* ── FEATURE CARDS — image tiles with hover overlay ── */
  .ncdr-bs-features{padding:80px 60px;background:var(--ncdr-off-white)}
  .ncdr-bs-features__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1200px;margin:0 auto}

  .ncdr-bs-fcard{position:relative;border-radius:4px;overflow:hidden;aspect-ratio:1/1;cursor:default;border:1px solid #1a1a1a}
  .ncdr-bs-fcard__img{position:absolute;inset:0}
  .ncdr-bs-fcard__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  .ncdr-bs-fcard:hover .ncdr-bs-fcard__img img{transform:scale(1.04)}

  .ncdr-bs-fcard__overlay{position:absolute;inset:0;background:rgba(8,14,5,0);transition:background .4s ease;z-index:1}
  .ncdr-bs-fcard:hover .ncdr-bs-fcard__overlay{background:rgba(8,14,5,.68)}

  .ncdr-bs-fcard__body{position:absolute;bottom:0;left:0;right:0;z-index:2;display:flex;flex-direction:column;align-items:flex-start;padding:28px 28px 32px;opacity:0;transform:translateY(8px);transition:opacity .4s ease,transform .4s ease}
  .ncdr-bs-fcard:hover .ncdr-bs-fcard__body{opacity:1;transform:translateY(0)}

  .ncdr-bs-fcard__title{font-family:var(--ncdr-font-heading);font-size:16px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#fff;margin-bottom:10px;line-height:1.2;text-align:left}
  .ncdr-bs-fcard__text{font-size:13px;color:rgba(255,255,255,.82);font-weight:300;line-height:1.75;text-align:left}

  /* ── HERITAGE SPLIT ── */
  .ncdr-bs-heritage{display:grid;grid-template-columns:1fr 1fr;min-height:560px;background:#fff}
  .ncdr-bs-heritage__text{padding:80px 64px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid var(--ncdr-light-gray)}
  .ncdr-bs-heritage__eyebrow{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--ncdr-gold);margin-bottom:24px;display:flex;align-items:center;gap:10px}
  .ncdr-bs-heritage__eyebrow::after{content:'';display:inline-block;width:32px;height:1px;background:var(--ncdr-gold);opacity:.4}
  .ncdr-bs-heritage__para{font-size:16px;color:var(--ncdr-text-dark);font-weight:300;line-height:1.9;margin-bottom:40px}
  .ncdr-bs-heritage__para .gold,.ncdr-bs-heritage__display .gold{color:var(--ncdr-gold);font-weight:600}
  .ncdr-bs-heritage__display{font-family:var(--ncdr-font-heading);font-size:clamp(28px,4vw,44px);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--ncdr-green-deep);line-height:1.1}
  .ncdr-bs-heritage__photo{position:relative;overflow:hidden;background:var(--ncdr-green-deep)}
  .ncdr-bs-heritage__photo img{width:100%;height:100%;object-fit:cover;display:block}

  /* ── CTA BAND ── */
  .ncdr-bs-cta{position:relative;min-height:400px;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:var(--ncdr-green-deep)}
  .ncdr-bs-cta__bg{position:absolute;inset:0;z-index:0}
  .ncdr-bs-cta__bg img{width:100%;height:100%;object-fit:cover;display:block}
  .ncdr-bs-cta__overlay{position:absolute;inset:0;background:rgba(8,14,5,.72);z-index:1}
  .ncdr-bs-cta__content{position:relative;z-index:2;padding:80px 40px;max-width:680px}
  .ncdr-bs-cta__heading{font-family:var(--ncdr-font-heading);font-size:clamp(26px,4vw,40px);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#fff;line-height:1.15;margin-bottom:14px}
  .ncdr-bs-cta__sub{font-size:15px;color:var(--ncdr-gold);font-weight:400;letter-spacing:.08em;text-transform:uppercase;margin-bottom:40px}
  .ncdr-bs-cta__buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .ncdr-bs-cta__btn{font-family:var(--ncdr-font-heading);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:14px 28px;border:1.5px solid rgba(255,255,255,.6);border-radius:3px;color:#fff;text-decoration:none;transition:background .2s,border-color .2s}
  .ncdr-bs-cta__btn:hover{background:rgba(255,255,255,.1);border-color:#fff}
  .ncdr-bs-cta__btn--gold{border-color:var(--ncdr-gold);color:var(--ncdr-gold)}
  .ncdr-bs-cta__btn--gold:hover{background:rgba(180,148,76,.15)}

  /* ── RESPONSIVE ── */
  @media(max-width:989px){
    .ncdr-bs-heritage{grid-template-columns:1fr}
    .ncdr-bs-heritage__text{border-right:none;border-bottom:1px solid var(--ncdr-light-gray);padding:60px 32px}
    .ncdr-bs-heritage__photo{min-height:340px}
    .ncdr-bs-features__grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:749px){
    .ncdr-bs-hero{height:100svh}
    .ncdr-bs-hero__content{padding:0 24px 60px}
    .ncdr-bs-statement{padding:64px 24px}
    .ncdr-bs-features{padding:48px 20px}
    .ncdr-bs-features__grid{grid-template-columns:1fr;gap:16px}
    .ncdr-bs-fcard{aspect-ratio:4/3;border:none}
    .ncdr-bs-heritage__text{padding:48px 24px}
    .ncdr-bs-cta__content{padding:60px 24px}
  }
</style>

<!-- HERO -->
<div class="ncdr-bs-hero">
  <video autoplay muted loop playsinline>
    <source src="https://cdn.shopify.com/videos/c/o/v/4b6e951b39e2443ebad763cb0413ce66.mp4" type="video/mp4">
  </video>
  <div class="ncdr-bs-hero__overlay"></div>
  <div class="ncdr-bs-hero__content">
    <h1 class="ncdr-bs-hero__heading">PRESTIGIO 14</h1>
    <p class="ncdr-bs-hero__sub">Crafted in Japan. Available at Northcrest.</p>
  </div>
</div>

<!-- STATEMENT -->
<div class="ncdr-bs-statement">
  <h2 class="ncdr-bs-statement__heading">The Pinnacle of Japanese Craftsmanship</h2>
  <p class="ncdr-bs-statement__body">Majesty's Prestigio 14 Series represents the marriage of hand-finished detail and material science—engineered for golfers who value precision, refinement, and effortless speed. Northcrest is honored to present this rare collection.</p>
</div>

<!-- FEATURE CARDS -->
<div class="ncdr-bs-features">
  <div class="ncdr-bs-features__grid">
    <div class="ncdr-bs-fcard">
      <div class="ncdr-bs-fcard__img">
        <img src="{{ 'Why Prestigio_1.png' | asset_url }}" alt="Crafted for Effortless Speed" loading="lazy">
      </div>
      <div class="ncdr-bs-fcard__overlay"></div>
      <div class="ncdr-bs-fcard__body">
        <div class="ncdr-bs-fcard__title">Crafted for Effortless Speed</div>
        <p class="ncdr-bs-fcard__text">Hyperion Titanium II, Power Frame 2.0, and high-repulsion face technology deliver pure energy transfer with every strike.</p>
      </div>
    </div>
    <div class="ncdr-bs-fcard">
      <div class="ncdr-bs-fcard__img">
        <img src="{{ 'Why Prestigio_2.png' | asset_url }}" alt="Stability in Every Swing" loading="lazy">
      </div>
      <div class="ncdr-bs-fcard__overlay"></div>
      <div class="ncdr-bs-fcard__body">
        <div class="ncdr-bs-fcard__title">Stability in Every Swing</div>
        <p class="ncdr-bs-fcard__text">Full Tungsten Sole construction and Optimal Core Impact design ensure consistent launch, forgiveness, and control across the entire clubface.</p>
      </div>
    </div>
    <div class="ncdr-bs-fcard">
      <div class="ncdr-bs-fcard__img">
        <img src="{{ 'Why Prestigio_3.png' | asset_url }}" alt="Ultra-Light Precision" loading="lazy">
      </div>
      <div class="ncdr-bs-fcard__overlay"></div>
      <div class="ncdr-bs-fcard__body">
        <div class="ncdr-bs-fcard__title">Ultra-Light Precision</div>
        <p class="ncdr-bs-fcard__text">LV770 and TL770 carbon shafts engineered for smooth acceleration, refined tempo, and unmatched feel through impact.</p>
      </div>
    </div>
  </div>
</div>

<!-- HERITAGE SPLIT -->
<div class="ncdr-bs-heritage">
  <div class="ncdr-bs-heritage__text">
    <div class="ncdr-bs-heritage__eyebrow">Heritage</div>
    <p class="ncdr-bs-heritage__para">Majesty selects only a handful of retailers worldwide to represent the Prestigio line. Northcrest is <span class="gold">one of nine</span> locations in the United States entrusted with this collection. Our team offers personalized guidance to help you experience the full performance of these handcrafted clubs.</p>
    <div class="ncdr-bs-heritage__display">A <span class="gold">RARE</span> PARTNERSHIP</div>
  </div>
  <div class="ncdr-bs-heritage__photo">
    <img src="{{ 'Prestigio_Rare Partnership_1.png' | asset_url }}" alt="Majesty heritage" loading="lazy">
  </div>
</div>

<!-- CTA BAND -->
<div class="ncdr-bs-cta">
  <div class="ncdr-bs-cta__bg">
    <img src="{{ 'Majesty CTA_Bags.png' | asset_url }}" alt="Book a consultation" loading="lazy">
  </div>
  <div class="ncdr-bs-cta__overlay"></div>
  <div class="ncdr-bs-cta__content">
    <h2 class="ncdr-bs-cta__heading">Experience It for Yourself</h2>
    <p class="ncdr-bs-cta__sub">Personalized fittings available at Northcrest</p>
    <div class="ncdr-bs-cta__buttons">
      <a href="tel:7707230002" class="ncdr-bs-cta__btn">Call the Pro Shop</a>
      <a href="/pages/contact" class="ncdr-bs-cta__btn ncdr-bs-cta__btn--gold">Message the Pro Shop</a>
    </div>
  </div>
</div>
